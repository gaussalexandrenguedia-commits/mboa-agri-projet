<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuration réseau de MBOA AGRI.
  Le trafic HTTP en clair est interdit par défaut depuis Android 9 (API 28).
  Le backend de développement de Martial tourne en HTTP sur la machine hôte
  de l'émulateur (http://10.0.2.2:8000/). On autorise donc le cleartext
  UNIQUEMENT pour ces hôtes de développement, jamais pour tout le domaine.

  Pour la production (FastAPI Cloud de Martial) en HTTPS, aucun cleartext n'est nécessaire.
  On autorise explicitement fastapicloud.dev en HTTPS (cleartext=false).
-->
<network-security-config>
    <!-- Développement local : cleartext autorisé uniquement pour émulateur -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>

    <!-- Production : HTTPS uniquement, pas de cleartext -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Production : autoriser explicitement les domaines de prod en HTTPS -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">fastapicloud.dev</domain>
        <domain includeSubdomains="true">backend-fastapi-d97b775d.fastapicloud.dev</domain>
        <domain includeSubdomains="true">railway.app</domain>
        <domain includeSubdomains="true">up.railway.app</domain>
        <domain includeSubdomains="true">onrender.com</domain>
        <domain includeSubdomains="true">mboa-agri.railway.app</domain>
        <domain includeSubdomains="true">api.mboa-agri.com</domain>
    </domain-config>
</network-security-config>
