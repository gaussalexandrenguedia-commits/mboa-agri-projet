# Copy to backend/.env for local development (never commit backend/.env).
# In production, set these as the hosting provider's environment variables.

# SQLAlchemy + psycopg. Supabase connection URL format:
# postgresql+psycopg://postgres.<PROJECT_REF>:<PASSWORD>@<POOLER_HOST>:6543/postgres
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/mboa_agri

ENVIRONMENT=development
# Replace with a unique random secret. Production requires at least 32 characters.
JWT_SECRET_KEY=CHANGE_ME_USE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Gemini API key from Google AI Studio. Keep it on the backend only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Required for image diagnosis upload; credentials from Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=mboa_agri/diagnostics

# JSON array of allowed browser origins; [] disables browser CORS access.
CORS_ORIGINS=[]
LOGIN_RATE_LIMIT=10
