# URL publique du backend de Martial, avec le slash final obligatoire pour Retrofit.
# Production (défaut du build) : https://backend-fastapi-d97b775d.fastapicloud.dev/
# Émulateur Android local : http://10.0.2.2:8000/
BACKEND_BASE_URL=https://backend-fastapi-d97b775d.fastapicloud.dev/

# Pour builder un APK avec une autre URL :
# export BACKEND_BASE_URL="https://backend-fastapi-d97b775d.fastapicloud.dev/"
# ./gradlew assembleDebug
# L'APK affichera l'URL active dans l'écran de connexion et dans Paramètres > Backend.

# Aucune clé Gemini ne doit être placée dans l’application Android.
# Les appels IA passent par :
# - POST /api/scans/diagnose (multipart, image + Gemini + Cloudinary)
# - POST /api/scans (offline sync avec JWT)

# Configuration JWT : le token est stocké en SharedPreferences après /auth/login
# Cycle : inscription (POST /auth/register) -> connexion (POST /auth/login) -> token Bearer
